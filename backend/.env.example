# JWT Secret
JWT_SECRET=your-secret-key-change-in-production
ENABLE_DEMO_ACCOUNT=false

# Session and execution limits
MAX_SESSIONS_PER_IP=10
MAX_EXECUTIONS_PER_HOUR=1000
SESSION_CREATE_RATE_LIMIT_WINDOW_MS=60000
SESSION_CREATE_RATE_LIMIT_MAX=20
EXECUTION_RATE_LIMIT_WINDOW_MS=10000
EXECUTION_RATE_LIMIT_MAX=30

# SMTP Configuration for Password Reset Emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="YaizY Python IDE" <noreply@yaizy.io>

# Frontend URL for password reset links
FRONTEND_URL=https://ide.yaizy.io
