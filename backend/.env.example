# JWT Secret (local session tokens)
JWT_SECRET=your-secret-key-change-in-production

# YaizY OAuth (login via yaizy.io, Authorization Code + PKCE)
# Authorize/token endpoints of the yaizy auth service
YAIZY_OAUTH_AUTHORIZE_URL=https://yaizy.io/api/auth2/oauth/authorize
YAIZY_OAUTH_TOKEN_URL=https://yaizy.io/api/auth2/oauth/token
# Client credentials issued for this application (yaizy DB -> oauth_clients)
YAIZY_OAUTH_CLIENT_ID=python-ide
YAIZY_OAUTH_CLIENT_SECRET=
# Public callback URL of this backend
AUTH_SERVER_OAUTH_JWT_SECRET=http://yaizy.io/api/auth/oauth/yaizy/callback
# Shared secret used to verify OAuth access tokens (HS256)
YAIZY_OAUTH_JWT_SECRET=
# Expected token issuer (optional, e.g. https://yaizy.io)
YAIZY_OAUTH_ISSUER=

# Session and execution limits
MAX_SESSIONS_PER_IP=10
MAX_EXECUTIONS_PER_HOUR=1000
SESSION_CREATE_RATE_LIMIT_WINDOW_MS=60000
SESSION_CREATE_RATE_LIMIT_MAX=20
EXECUTION_RATE_LIMIT_WINDOW_MS=10000
EXECUTION_RATE_LIMIT_MAX=30

# Frontend URL (used as OAuth callback origin + redirects)
FRONTEND_URL=https://ide.yaizy.io
